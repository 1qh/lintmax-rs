{
  "lineWidth": 100,
  "indentWidth": 2,
  "useTabs": false,
  "newLineKind": "lf",
  "includes": [
    "**/*"
  ],
  "excludes": [
    "target/",
    "Cargo.lock"
  ],
  "plugins": [
    "npm:@dprint/json@0.26.0",
    "npm:@dprint/markdown@0.29.0",
    "npm:@dprint/toml@0.10.0",
    "npm:@dprint/dockerfile@0.8.0",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-graphql@0.2.3",
    "npm:lax-sql@0.3.0"
  ]
}
